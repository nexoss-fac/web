# Plantilla de variables. No pegar valores reales en GitHub ni en archivos del cliente.
# Modo local aislado: el adaptador de archivos solo sirve para pruebas con datos sintéticos.
NEXOSS_MULTIEMPRESA_MODE=local-demo
VITE_NEXOSS_LOCAL_ONLY=true

# Emulador ficticio de Firebase Authentication (sin credenciales de servicio).
FIREBASE_PROJECT_ID=demo-nexoss
GOOGLE_CLOUD_PROJECT=demo-nexoss
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
VITE_FIREBASE_API_KEY=fake-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-nexoss.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-nexoss
VITE_FIREBASE_APP_ID=1:123456789:web:local
VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099

# Opcional: solo UID de cuentas creadas en el emulador local. Nunca usar aquí UID de producción.
NEXOSS_PLATFORM_ADMIN_UIDS=

# Base central separada de las bases operativas por empresa.
CONTROL_PLANE_DATABASE_URL=

# Identidad: elegir un proveedor y verificar tokens en el servidor.
AUTH_PROVIDER=
AUTH_PROJECT_ID=

# Preferir un gestor de secretos/KMS para descifrar secretos de conexiones tenant.
# Si se implementa cifrado de aplicación, la clave debe tener alta entropía,
# almacenarse solo en Vercel Environment Variables/gestor de secretos y rotarse.
TENANT_SECRET_PROVIDER=
TENANT_SECRET_KEY_VERSION=

# Almacenamiento privado de documentos fiscales (no usar buckets públicos).
FISCAL_STORAGE_PROVIDER=
FISCAL_STORAGE_BUCKET=


# Notificaciones push propias del navegador (genera el par con: npx web-push generate-vapid-keys)
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:admin@tu-dominio.com
