# Copy to a private local environment file when implementation begins.
# Never commit real credentials. All values below are intentionally blank.
APP_ENV=development
APP_BASE_URL=
APP_PUBLIC_URL=
DATABASE_URL=
AUTH_SECRET=

# Correo transaccional de invitaciones. Elige smtp o resend.
# Namecheap/cPanel for nexoss.site: SMTP host nexoss.site, port 465, SSL/TLS enabled.
# Set MAIL_PROVIDER=smtp in the deployment environment; do not commit passwords.
MAIL_PROVIDER=
MAIL_FROM=invitaciones@nexoss.site
SMTP_HOST=nexoss.site
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=invitaciones@nexoss.site
SMTP_PASS=

# Alternativa Resend: requiere remitente/dominio autorizado por Resend.
RESEND_API_KEY=

# Firebase web config (pública en el bundle; no poner aquí claves privadas).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Firebase Authentication Emulator (opcional, solo desarrollo local).
VITE_FIREBASE_AUTH_EMULATOR_URL=
FIREBASE_AUTH_EMULATOR_HOST=

# Firebase Admin en servidor local: usa ADC y un archivo de credenciales
# guardado fuera del repositorio. No pegar aquí el JSON de cuenta de servicio.
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=


# Notificaciones push propias del navegador (genera el par con: npx web-push generate-vapid-keys)
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:admin@tu-dominio.com
