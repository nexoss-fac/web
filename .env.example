# Copy to a private local environment file when implementation begins.
# Never commit real credentials. All values below are intentionally blank.
APP_ENV=development
APP_BASE_URL=
APP_PUBLIC_URL=
DATABASE_URL=
AUTH_SECRET=

# Correo transaccional de invitaciones (Resend, plan gratuito).
# Usa un dominio verificado y una clave con permiso de envío; nunca subas secretos al repositorio.
MAIL_PROVIDER=resend
MAIL_FROM=
RESEND_API_KEY=

# Firebase web config (pública en el bundle; no poner aquí claves privadas).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Firebase Authentication Emulator (opcional, solo desarrollo local).
VITE_FIREBASE_AUTH_EMULATOR_URL=
FIREBASE_AUTH_EMULATOR_HOST=

# Firebase Admin en servidor: preferir ADC en Google Cloud o un archivo secreto montado.
# En Render, puede usarse FIREBASE_ADMIN_CREDENTIALS_JSON como variable secreta
# con el JSON de la cuenta de servicio. Nunca pongas el valor real en este archivo.
FIREBASE_PROJECT_ID=
FIREBASE_ADMIN_CREDENTIALS_JSON=
GOOGLE_APPLICATION_CREDENTIALS=


# Notificaciones push propias del navegador (genera el par con: npx web-push generate-vapid-keys)
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:admin@tu-dominio.com
